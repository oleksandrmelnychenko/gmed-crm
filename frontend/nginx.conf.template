map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The OAuth callback carries a one-time code. Never put its query in access logs.
  location = /api/v1/datev/oauth/callback {
    access_log off;
    proxy_read_timeout 120s;
    proxy_pass ${GMED_BACKEND_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Referrer-Policy no-referrer always;
  }

  # A read can refresh a token, check the company, then fetch bounded data.
  location ^~ /api/v1/admin/datev/ {
    proxy_pass ${GMED_BACKEND_UPSTREAM};
    proxy_read_timeout 120s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Machine translation may OCR a scanned PDF and runs on CPU.
  location ~ ^/api/v1/documents/(translation-requests/)?[^/]+/(translations/preview|machine-draft)$ {
    proxy_pass ${GMED_BACKEND_UPSTREAM};
    proxy_read_timeout 180s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    # Document uploads are validated by the backend at 25 MiB. Keep enough
    # proxy headroom for multipart boundaries and accompanying form fields.
    client_max_body_size 30m;
    proxy_pass ${GMED_BACKEND_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  # Module workers require a JavaScript MIME type; nginx's default mime.types
  # does not include .mjs. Never fall back to the SPA for a missing worker.
  location ~ \.mjs$ {
    types { application/javascript mjs; }
    try_files $uri =404;
  }

  # The app shell must be revalidated on every load, otherwise a browser may
  # keep an index.html from before a deploy that points at old bundles.
  location = /index.html {
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  location = /service-worker.js {
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  # Hashed bundles never change. A missing one must be a 404 (not the SPA
  # shell), so the stale-chunk recovery in the app reloads the new release.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
