# Copy to .env.mobile for a local native build. Use the HTTPS API origin only;
# /api/v1 is appended by src/lib/api.ts.
VITE_API_BASE_URL=https://console-dev.gmed-health.com

# The API deployment must include these exact native origins in CORS_ORIGIN:
# https://localhost,capacitor://localhost

# Override only before the first store release if the final bundle identifier differs.
# CAPACITOR_APP_ID=com.gmedhealth.console
# CAPACITOR_APP_NAME=GMED Console
