# syntax=docker/dockerfile:1.7

FROM rust:slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV SQLX_OFFLINE=true

COPY .cargo ./.cargo
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
COPY .sqlx ./.sqlx
COPY docs/comparison/fonts ./docs/comparison/fonts

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --locked --release -p gmed-server --bin gmed-server \
    && cp target/release/gmed-server /tmp/gmed-server

FROM debian:bookworm-slim AS runtime

ARG GMED_RUNTIME_UID=100
ARG GMED_RUNTIME_GID=101

# Keep the runtime identity stable across package changes. The uploads volume
# stores numeric ownership, so allowing apt packages to shift this UID/GID can
# make existing private documents unwritable after an image upgrade.
RUN addgroup --system --gid "${GMED_RUNTIME_GID}" gmed \
    && adduser --system --uid "${GMED_RUNTIME_UID}" --ingroup gmed --home /app gmed \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clamav \
        clamav-freshclam \
        curl \
        openssl \
        tesseract-ocr \
        tesseract-ocr-deu \
        tesseract-ocr-eng \
        tesseract-ocr-rus \
        tesseract-ocr-ukr \
    && freshclam --quiet \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /app/uploads/chat /app/uploads/documents \
    && chown -R gmed:gmed /app

COPY --from=builder /tmp/gmed-server /usr/local/bin/gmed-server
COPY scripts/prepare-upload-volume.sh /usr/local/bin/gmed-prepare-uploads
RUN chmod 0755 /usr/local/bin/gmed-prepare-uploads

USER gmed:gmed

ENV PORT=3000
ENV RUST_LOG=info,gmed_server=debug

EXPOSE 3000
VOLUME ["/app/uploads"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["sh", "-c", "test -w /app/uploads/documents && curl --fail --silent http://127.0.0.1:${PORT:-3000}/health > /dev/null || exit 1"]

ENTRYPOINT ["gmed-server"]
