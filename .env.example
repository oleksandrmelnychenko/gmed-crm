DATABASE_URL=postgres://gmed:gmed@localhost:5432/gmed
PORT=3000

# JWT signing secret. Generate with: openssl rand -base64 48
# Server REFUSES to start if this is unset or matches a known placeholder.
JWT_SECRET=REPLACE_ME_WITH_FRESH_SECRET

# Message encryption key registry. Format: `id1:base64key,id2:base64key,...`
# Each key must decode to exactly 32 bytes (AES-256). Generate with:
#   openssl rand -base64 32
#
# Rotation procedure:
#   1. Generate a fresh key, append it to MESSAGE_ENCRYPTION_KEYS.
#   2. Set MESSAGE_ENCRYPTION_KEY_ACTIVE to the new id, restart.
#   3. New writes use the new key. Old writes still readable thanks to the
#      old key remaining in the registry.
#   4. Run POST /admin/security/key-rotation/rewrap repeatedly (or wait for
#      the periodic background sweep) until status reports 100% on the
#      active id.
#   5. Remove the old key from MESSAGE_ENCRYPTION_KEYS, restart again.
MESSAGE_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
MESSAGE_ENCRYPTION_KEY_ACTIVE=v1
# Optional but recommended in production so JWT rotation does not destroy
# audit-log IP hash continuity. Generate with: openssl rand -base64 32
AUDIT_IP_SALT=REPLACE_ME_WITH_FRESH_SALT

# Public frontend origin. For the bundled container stack this is usually
# http://localhost:8080 locally and your ALB / domain origin in AWS.
# Exact origins only. Native Capacitor builds use https://localhost on Android
# and capacitor://localhost on iOS.
CORS_ORIGIN=http://localhost:8080,https://localhost,capacitor://localhost
RUST_LOG=info,gmed_server=debug

# Optional G-BA AIS complete-delivery connector. Obtain the permanently valid
# automated download URL from G-BA after accepting its terms. The value may
# contain an access token: keep it in the deployment secret store, never in git.
# The connector remains planned/disabled when this variable is absent.
# GMED_GBA_AIS_DOWNLOAD_URL=https://ais.g-ba.de/REPLACE_WITH_ISSUED_PATH

# Optional Medication Evidence AI draft. Safe default: fully disabled. The
# backend performs an external call only when BOTH flags are true and a
# server-only key/model are configured. Never expose the key to the frontend.
# Do not enable DATA_TRANSFER_APPROVED until the documented GDPR/vendor review
# (including retention and transfer terms) is complete for this environment.
# When both gates are enabled, an environment-specific governance approval ID
# is also required. Use only [A-Za-z0-9._-] (max 96); do not put a URL, name,
# email address, or review text in this server-only provenance identifier.
GMED_MEDICATION_AI_ENABLED=false
GMED_MEDICATION_AI_DATA_TRANSFER_APPROVED=false
# GMED_MEDICATION_AI_GOVERNANCE_REVIEW_ID=gov-review-prod-2026-08
# GMED_OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_KEY
# GMED_OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL_ID

# For `docker compose -f docker-compose.yml -f docker-compose.release.yml ...`
# prefer separate release variables so the container stack does not accidentally
# inherit local dev values from `.env`.
# GMED_DATABASE_URL=postgres://gmed:gmed@postgres:5432/gmed
# GMED_JWT_SECRET=REPLACE_ME_WITH_FRESH_SECRET
# GMED_MESSAGE_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
# GMED_MESSAGE_ENCRYPTION_KEY_ACTIVE=v1
# GMED_AUDIT_IP_SALT=REPLACE_ME_WITH_FRESH_SALT
# GMED_CORS_ORIGIN=http://localhost:8080
# GMED_LEAD_INTAKE_TOKEN=REPLACE_ME_WITH_SHARED_WEBSITE_INTAKE_TOKEN
# GMED_RUST_LOG=info,gmed_server=debug
# GMED_GBA_AIS_DOWNLOAD_URL=https://ais.g-ba.de/REPLACE_WITH_ISSUED_PATH
# GMED_MEDICATION_AI_ENABLED=false
# GMED_MEDICATION_AI_DATA_TRANSFER_APPROVED=false
# GMED_MEDICATION_AI_GOVERNANCE_REVIEW_ID=gov-review-prod-2026-08
# GMED_OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_KEY
# GMED_OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL_ID
# Generic image OCR performed by the Rust document API (Tesseract CLI).
# GMED_DOCUMENT_OCR_TIMEOUT_SECONDS=30
# GMED_DOCUMENT_OCR_MAX_CONCURRENCY=2
# GMED_DOCUMENT_OCR_LANGUAGES=deu+eng+ukr+rus
# GMED_PARSER_OCR_ENGINE=paddle
# GMED_PARSER_OCR_PAGE_TIMEOUT_SECONDS=45
# GMED_PARSER_OCR_DOCUMENT_TIMEOUT_SECONDS=300
# GMED_PARSER_PADDLE_ISOLATE_PROCESS=true
# GMED_PARSER_PADDLE_FAILURE_THRESHOLD=2
# GMED_PARSER_PADDLE_COOLDOWN_SECONDS=60
# GMED_PARSER_OCR_MULTIPASS=true
# GMED_PARSER_OCR_PRIMARY_LANGUAGES=deu+eng
# GMED_PARSER_OCR_CYRILLIC_LANGUAGES=deu+eng+rus+ukr
# GMED_PARSER_OCR_UKRAINIAN_LANGUAGES=deu+eng+ukr
# GMED_PARSER_OCR_RUSSIAN_LANGUAGES=deu+eng+rus

# Invoice import preview: Rust API -> standalone invoice parser (server only).
# Base URL; use the service hostname on a shared private network in containers.
# INVOICE_PARSER_URL=http://127.0.0.1:8091
# INVOICE_PARSER_API_KEY=REPLACE_WITH_SHARED_SECRET_AT_LEAST_32_CHARACTERS
# Leave unset to keep manual invoice review available without OCR.

# Electronic signatures: German Skribble account / Germany data hosting only.
# Disabled until the account, contract and data processing terms are configured.
DOCUMENT_SIGNATURES_ENABLED=false
DOCUMENT_SIGNATURES_MODE=demo
# SKRIBBLE_USERNAME=api_demo_REPLACE_ME
# SKRIBBLE_API_KEY=SERVER_ONLY_SECRET
# To activate real eIDAS QES: set MODE=live and use the matching api_prod... account.
# Demo signatures are archived as TEST evidence and do not mark real documents signed.
# Docker release environment equivalents (server-only; never VITE_*):
# GMED_DOCUMENT_SIGNATURES_ENABLED=false
# GMED_DOCUMENT_SIGNATURES_MODE=demo
# GMED_SKRIBBLE_USERNAME=api_demo_REPLACE_ME
# GMED_SKRIBBLE_API_KEY=SERVER_ONLY_SECRET
