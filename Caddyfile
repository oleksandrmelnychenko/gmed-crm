# Caddy as the TLS-terminating edge proxy.
#
# Caddy handles Let's Encrypt issuance + renewal automatically. The
# server (or VM) must:
#   1. Have its DNS A/AAAA records pointing here BEFORE Caddy starts,
#      otherwise the ACME HTTP-01 challenge fails until they do.
#   2. Have ports 80 and 443 reachable from the public internet (the
#      Hetzner firewall in `hcloud-firewall` opens them when
#      `allow_http`/`allow_https` are true).
#
# Hostname and ACME contact email are taken from env so the same file
# works for `console.gmed-health.com` (prod) and `console-dev.gmed-health.com`
# (dev). The `:?` syntax fails fast if either is missing.
#
# We forward to the frontend container (nginx on :8080). The frontend
# already reverse-proxies `/api/*` to the backend, so Caddy stays
# single-route — keeping the chain to two hops (client → Caddy → nginx)
# and the rate-limit accounting predictable. The backend has
# `TRUST_FORWARDED_HEADERS=true` set in the Hetzner compose override,
# so `rate_limit.rs` keys off the original client IP rather than the
# inter-container hop.

{
	email {$ACME_EMAIL}
	# Production CA by default. To test against staging without burning
	# rate-limit quota, set CADDY_ACME_CA="https://acme-staging-v02.api.letsencrypt.org/directory"
	# and uncomment the line below.
	# acme_ca {$CADDY_ACME_CA}
}

{$CADDY_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Content-Security-Policy for the web application.
	#
	# `?` writes the header only when the upstream did not send one, so the
	# backend's own stricter policy on every /api response
	# (`default-src 'none'`, crates/server/src/security_headers.rs) is kept
	# as it is and never duplicated; everything else (the app shell, bundles,
	# static files) gets the policy below.
	#
	# What the application needs, and nothing more:
	#   script-src   own bundles only (no inline script, no eval);
	#                'wasm-unsafe-eval' for the pdf.js image decoders
	#   style-src    'unsafe-inline' for style attributes set by UI libraries
	#   img/font     own files, plus blob:/data: previews and inlined fonts
	#   connect-src  own API; the same-origin WebSocket is spelled out for
	#                browsers that do not treat it as 'self'
	#   frame-src    document previews are blob: URLs in an <iframe>
	#   object-src   a PDF opened from a blob: URL inherits this policy and
	#                some built-in PDF viewers load it as a plugin; no other
	#                origin is allowed
	#   worker-src   pdf.js worker and the service worker
	#
	# The header name comes from GMED_CSP_HEADER (docker-compose.hetzner.yml):
	# set it to Content-Security-Policy-Report-Only in the env file to watch
	# violations in the browser console without blocking anything.
	header ?{$GMED_CSP_HEADER:Content-Security-Policy} "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' wss://{host}; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	reverse_proxy frontend:8080 {
		# Caddy sets X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host
		# automatically; no overrides needed.
		transport http {
			# A long-running upload or download must not be killed by a
			# default 30s read timeout on the upstream.
			read_timeout 10m
			write_timeout 10m
		}
	}

	# JSON structured logs go to stdout so `docker logs caddy` (and any
	# log driver we plug in later, e.g. Loki) can ingest them as-is.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
				}
			}
		}
	}
}
